# ============================================================================
# VARIABLES DE ENTORNO DEL BACKEND · TEKZON C.A.
# ============================================================================
# Copie este archivo como `.env` en la carpeta Backend y ajuste los valores.
# ============================================================================

# ---------------------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------------------
# Puerto donde escucha el API REST consumido por el frontend en Vue 3.
PORT=3000

# ---------------------------------------------------------------------------
# BASE DE DATOS RELACIONAL (MySQL / MariaDB · MySQL Workbench)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tekzon_bd
DB_PORT=3306

# ---------------------------------------------------------------------------
# SEGURIDAD · FIRMA DE LOS TOKENS DE SESIÓN (Módulo 1 · LOGIN)
# ---------------------------------------------------------------------------
# Clave secreta con la que se firma (HMAC-SHA256) el token de sesión que emite
# POST /api/autenticacion/login. Cámbiela por una cadena larga y privada:
# si un tercero la conoce, podría fabricar tokens válidos.
#
# Para generar una clave aleatoria desde la consola:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=cambie-esta-clave-por-una-larga-y-privada
