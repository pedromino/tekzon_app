# ============================================================================
# VARIABLES DE ENTORNO DEL FRONTEND · TEKZON C.A.
# ============================================================================
# El cliente Axios (src/services/apiClient.js) lee VITE_API_URL para construir
# la dirección base del API RESTful del backend.
#
# VITE_ID_USUARIO identifica al usuario responsable que firma los movimientos
# del kádex (clave foránea `fk_movimiento_usuario`). Corresponde al usuario
# almacenista sembrado por la migración 004 mientras el módulo de autenticación
# de la FASE II no esté operativo.
# ============================================================================

VITE_API_URL=http://localhost:3000/api
VITE_ID_USUARIO=1
